{
  "name": "libmanager-flutter-libraries",
  "displayName": "Registry Libraries",
  "description": "Manage Registry private from Nexus repository",
  "version": "2.0.0",
  "publisher": "KaneBaltazarAlanoca",
  "repository": {
    "type": "git",
    "url": "https://github.com/innovadeveloper/libmanager-flutter-libraries"
  },
  "homepage": "https://github.com/innovadeveloper/libmanager-flutter-libraries#readme",
  "bugs": {
    "url": "https://github.com/innovadeveloper/libmanager-flutter-libraries/issues"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "flutter",
    "dart",
    "libraries",
    "nexus",
    "private",
    "packages"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "libmanager.refreshLibraries",
        "title": "[LibManager] Refresh Libraries",
        "icon": "$(refresh)"
      },
      {
        "command": "libmanager.installLibrary",
        "title": "[LibManager] Install Library",
        "icon": "$(cloud-download)"
      },
      {
        "command": "libmanager.publishLibrary",
        "title": "[LibManager] Publish Library",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "libmanager.updateLibrary",
        "title": "[LibManager] Update Library",
        "icon": "$(sync)"
      },
      {
        "command": "libmanager.removeLibrary",
        "title": "[LibManager] Remove Library",
        "icon": "$(trash)"
      },
      {
        "command": "libmanager.openSettings",
        "title": "[LibManager] Open Settings",
        "icon": "$(gear)"
      },
      {
        "command": "libmanager.viewLibraryDetails",
        "title": "[LibManager] View Details",
        "icon": "$(info)"
      },
      {
        "command": "libmanager.showDetails",
        "title": "[LibManager] Show Details"
      },
      {
        "command": "libmanager.updateCredentials",
        "title": "[LibManager] Update Artifactory Credentials",
        "icon": "$(key)"
      }
    ],
    "views": {
      "libmanager-explorer": [
        {
          "id": "libmanagerLibraries",
          "name": "Lib Manager",
          "when": "true"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "libmanager-explorer",
          "title": "Lib Manager",
          "icon": "$(package)"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "libmanager.refreshLibraries",
          "when": "view == libmanagerLibraries",
          "group": "navigation@1"
        },
        {
          "command": "libmanager.publishLibrary",
          "when": "view == libmanagerLibraries",
          "group": "navigation@2"
        },
        {
          "command": "libmanager.openSettings",
          "when": "view == libmanagerLibraries",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "libmanager.installLibrary",
          "when": "view == libmanagerLibraries && viewItem == availableLibrary",
          "group": "inline@1"
        },
        {
          "command": "libmanager.viewLibraryDetails",
          "when": "view == libmanagerLibraries && viewItem == availableLibrary",
          "group": "context@1"
        },
        {
          "command": "libmanager.updateLibrary",
          "when": "view == libmanagerLibraries && viewItem == installedLibrary",
          "group": "inline@1"
        },
        {
          "command": "libmanager.removeLibrary",
          "when": "view == libmanagerLibraries && viewItem == installedLibrary",
          "group": "inline@2"
        },
        {
          "command": "libmanager.viewLibraryDetails",
          "when": "view == libmanagerLibraries && viewItem == installedLibrary",
          "group": "context@1"
        },
        {
          "command": "libmanager.showDetails",
          "when": "view == libmanagerLibraries && (viewItem == availableLibrary || viewItem == installedLibrary)",
          "group": "inline@0"
        }
      ]
    },
    "configuration": {
      "title": "LibManager Flutter Libraries",
      "properties": {
        "libmanager.nexusUrl": {
          "type": "string",
          "default": "",
          "description": "Nexus repository URL for Flutter libraries",
          "pattern": "^https?://.*",
          "patternErrorMessage": "Must be a valid HTTP(S) URL"
        },
        "libmanager.username": {
          "type": "string",
          "default": "",
          "description": "Username for Nexus authentication"
        },
        "libmanager.autoRefresh": {
          "type": "boolean",
          "default": true,
          "description": "Automatically refresh libraries list on startup"
        },
        "libmanager.packagesDirectory": {
          "type": "string",
          "default": "build/packages",
          "description": "Directory where private libraries are stored"
        },
        "libmanager.showNotifications": {
          "type": "boolean",
          "default": true,
          "description": "Show success/error notifications"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "package": "vsce package",
    "deploy": "vsce publish"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.101.0",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.2.0",
    "eslint": "^9.25.1",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@types/fs-extra": "^11.0.4",
    "axios": "^1.7.0",
    "fs-extra": "^11.2.0",
    "tar": "^7.4.3",
    "yaml": "^2.6.1"
  }
}
